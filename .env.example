# HeartSync Environment Variables
# Copy this file to .env and update the values

# Security
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=False

# Database
DATABASE_PATH=app/database/heartsync.db

# Application
APP_NAME=HeartSync
APP_VERSION=1.0.0

# Anniversary Date (YYYY-MM-DD)
ANNIVERSARY_DATE=2026-04-01

# Passphrase for authentication
USER_A_NAME=taotao
USER_B_NAME=fangfang
USER_A_PASSPHRASE=fangfang
USER_B_PASSPHRASE=taotao

# Email notification (QQ mail)
# QQ邮箱需开启SMTP服务并在QQ邮箱设置中获取授权码
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-qq-email@qq.com
SMTP_PASSWORD=your-smtp-authorization-code
USER_A_NOTIFY_EMAIL=user-a-email@qq.com
USER_B_NOTIFY_EMAIL=user-b-email@qq.com

# Reminder check hour (0-23), emails only sent after this hour
REMINDER_CHECK_HOUR=21

# Reminder email content (use {user_name} and {today} as placeholders)
# \n will be converted to newlines in the email body
REMINDER_EMAIL_SUBJECT=提醒：{today} 工作总结尚未填写
REMINDER_EMAIL_BODY=Hi {user_name}，\n\n今天是 {today}，你还没有填写每日工作总结/签到哦～\n\n请尽快登录心动坐标记录今日的工作事项：\nhttp://taofang.site/work-summary\n\n保持好习惯，每天都总结！\n\n—— 心动坐标 · 自动提醒